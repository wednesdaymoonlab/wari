#!/usr/bin/env bash

set -Eeuo pipefail

WARI_VERSION='0.2.0'
WARI_RUNTIME_OWNER='Wari runtime layout 2'

die() {
    printf 'Error: %s\n' "$1" >&2
    return 1
}

reset_lock_state() {
    LOCK_VERSION=''
    LOCK_WARI_VERSION=''
    LOCK_FRANKENPHP_VERSION=''
    LOCK_COMPOSER_VERSION=''
    LOCK_LINUX_BUILD=''
    LOCK_WARI_SHA256=''
    LOCK_COMPOSER_INSTALLER_SHA384=''
    LOCK_COMPOSER_SHA256=''
    LOCK_FRANKENPHP_LINUX_X86_64_SHA256=''
    LOCK_FRANKENPHP_LINUX_ARM64_SHA256=''
    LOCK_FRANKENPHP_MACOS_X86_64_SHA256=''
    LOCK_FRANKENPHP_MACOS_ARM64_SHA256=''

    SEEN_LOCK_VERSION=0
    SEEN_WARI_VERSION=0
    SEEN_FRANKENPHP_VERSION=0
    SEEN_COMPOSER_VERSION=0
    SEEN_LINUX_BUILD=0
    SEEN_WARI_SHA256=0
    SEEN_COMPOSER_INSTALLER_SHA384=0
    SEEN_COMPOSER_SHA256=0
    SEEN_FRANKENPHP_LINUX_X86_64_SHA256=0
    SEEN_FRANKENPHP_LINUX_ARM64_SHA256=0
    SEEN_FRANKENPHP_MACOS_X86_64_SHA256=0
    SEEN_FRANKENPHP_MACOS_ARM64_SHA256=0
}

assign_lock_value() {
    local key="$1"
    local value="$2"

    case "$key" in
        lock_version)
            [[ "$SEEN_LOCK_VERSION" -eq 0 ]] || return 1
            SEEN_LOCK_VERSION=1
            LOCK_VERSION="$value"
            ;;
        wari_version)
            [[ "$SEEN_WARI_VERSION" -eq 0 ]] || return 1
            SEEN_WARI_VERSION=1
            LOCK_WARI_VERSION="$value"
            ;;
        frankenphp_version)
            [[ "$SEEN_FRANKENPHP_VERSION" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_VERSION=1
            LOCK_FRANKENPHP_VERSION="$value"
            ;;
        composer_version)
            [[ "$SEEN_COMPOSER_VERSION" -eq 0 ]] || return 1
            SEEN_COMPOSER_VERSION=1
            LOCK_COMPOSER_VERSION="$value"
            ;;
        linux_build)
            [[ "$SEEN_LINUX_BUILD" -eq 0 ]] || return 1
            SEEN_LINUX_BUILD=1
            LOCK_LINUX_BUILD="$value"
            ;;
        wari_sha256)
            [[ "$SEEN_WARI_SHA256" -eq 0 ]] || return 1
            SEEN_WARI_SHA256=1
            LOCK_WARI_SHA256="$value"
            ;;
        composer_installer_sha384)
            [[ "$SEEN_COMPOSER_INSTALLER_SHA384" -eq 0 ]] || return 1
            SEEN_COMPOSER_INSTALLER_SHA384=1
            LOCK_COMPOSER_INSTALLER_SHA384="$value"
            ;;
        composer_sha256)
            [[ "$SEEN_COMPOSER_SHA256" -eq 0 ]] || return 1
            SEEN_COMPOSER_SHA256=1
            LOCK_COMPOSER_SHA256="$value"
            ;;
        frankenphp_linux_x86_64_sha256)
            [[ "$SEEN_FRANKENPHP_LINUX_X86_64_SHA256" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_LINUX_X86_64_SHA256=1
            LOCK_FRANKENPHP_LINUX_X86_64_SHA256="$value"
            ;;
        frankenphp_linux_arm64_sha256)
            [[ "$SEEN_FRANKENPHP_LINUX_ARM64_SHA256" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_LINUX_ARM64_SHA256=1
            LOCK_FRANKENPHP_LINUX_ARM64_SHA256="$value"
            ;;
        frankenphp_macos_x86_64_sha256)
            [[ "$SEEN_FRANKENPHP_MACOS_X86_64_SHA256" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_MACOS_X86_64_SHA256=1
            LOCK_FRANKENPHP_MACOS_X86_64_SHA256="$value"
            ;;
        frankenphp_macos_arm64_sha256)
            [[ "$SEEN_FRANKENPHP_MACOS_ARM64_SHA256" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_MACOS_ARM64_SHA256=1
            LOCK_FRANKENPHP_MACOS_ARM64_SHA256="$value"
            ;;
        *)
            die "unknown Wari lock key: $key"
            return 1
            ;;
    esac
}

validate_complete_lock() {
    local seen

    for seen in \
        "$SEEN_LOCK_VERSION" \
        "$SEEN_WARI_VERSION" \
        "$SEEN_FRANKENPHP_VERSION" \
        "$SEEN_COMPOSER_VERSION" \
        "$SEEN_LINUX_BUILD" \
        "$SEEN_WARI_SHA256" \
        "$SEEN_COMPOSER_INSTALLER_SHA384" \
        "$SEEN_COMPOSER_SHA256" \
        "$SEEN_FRANKENPHP_LINUX_X86_64_SHA256" \
        "$SEEN_FRANKENPHP_LINUX_ARM64_SHA256" \
        "$SEEN_FRANKENPHP_MACOS_X86_64_SHA256" \
        "$SEEN_FRANKENPHP_MACOS_ARM64_SHA256"; do
        if [[ "$seen" -ne 1 ]]; then
            die 'Wari lock is missing one or more required keys'
            return 1
        fi
    done

    [[ "$LOCK_VERSION" == '1' ]] || {
        die "unsupported Wari lock version: $LOCK_VERSION"
        return 1
    }
    [[ "$LOCK_WARI_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    [[ "$LOCK_COMPOSER_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    [[ "$LOCK_LINUX_BUILD" == 'static' || "$LOCK_LINUX_BUILD" == 'gnu' ]] || return 1
    [[ "$LOCK_WARI_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_COMPOSER_INSTALLER_SHA384" =~ ^[0-9a-f]{96}$ ]] || return 1
    [[ "$LOCK_COMPOSER_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_LINUX_X86_64_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_LINUX_ARM64_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_MACOS_X86_64_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_MACOS_ARM64_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
}

parse_lock() {
    local path="$1"
    local line
    local key
    local value

    if [[ ! -f "$path" || -L "$path" ]]; then
        die "invalid Wari lock: $path"
        return 1
    fi

    reset_lock_state
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ ! "$line" =~ ^[a-z0-9_]+=[^[:space:][:cntrl:]]+$ ]]; then
            die 'invalid Wari lock line'
            return 1
        fi
        key="${line%%=*}"
        value="${line#*=}"
        assign_lock_value "$key" "$value" || return 1
    done <"$path"

    validate_complete_lock
}

select_locked_asset() {
    case "${PLATFORM_OS:-}/${PLATFORM_ARCH:-}" in
        linux/x86_64)
            ASSET_NAME='frankenphp-linux-x86_64'
            [[ "$LOCK_LINUX_BUILD" == 'static' ]] || ASSET_NAME="$ASSET_NAME-gnu"
            ASSET_SHA256="$LOCK_FRANKENPHP_LINUX_X86_64_SHA256"
            ;;
        linux/arm64)
            ASSET_NAME='frankenphp-linux-aarch64'
            [[ "$LOCK_LINUX_BUILD" == 'static' ]] || ASSET_NAME="$ASSET_NAME-gnu"
            ASSET_SHA256="$LOCK_FRANKENPHP_LINUX_ARM64_SHA256"
            ;;
        darwin/x86_64)
            ASSET_NAME='frankenphp-mac-x86_64'
            ASSET_SHA256="$LOCK_FRANKENPHP_MACOS_X86_64_SHA256"
            ;;
        darwin/arm64)
            ASSET_NAME='frankenphp-mac-arm64'
            ASSET_SHA256="$LOCK_FRANKENPHP_MACOS_ARM64_SHA256"
            ;;
        *)
            die "unsupported Wari platform: ${PLATFORM_OS:-unknown} ${PLATFORM_ARCH:-unknown}"
            return 1
            ;;
    esac
}

has_glibc() {
    local output

    if command -v getconf >/dev/null 2>&1; then
        output="$(getconf GNU_LIBC_VERSION 2>/dev/null || true)"
        [[ "$output" == glibc\ * ]] && return 0
    fi
    if command -v ldd >/dev/null 2>&1; then
        output="$(ldd --version 2>&1 || true)"
        [[ "$output" == *glibc* || "$output" == *GLIBC* ||
            "$output" == *'GNU libc'* ]] && return 0
    fi
    return 1
}

can_show_download_progress() {
    [[ -t 2 ]]
}

curl_to_file() {
    local url="$1"
    local destination="$2"
    local progress_label="$3"
    shift 3
    local attempt=1
    local max_attempts=4
    local status
    local -a output_options

    while ((attempt <= max_attempts)); do
        if [[ -n "$progress_label" ]] && can_show_download_progress; then
            if ((attempt == 1)); then
                printf 'Downloading %s\n' "$progress_label" >&2
            else
                printf 'Downloading %s (attempt %s/%s)\n' \
                    "$progress_label" "$attempt" "$max_attempts" >&2
            fi
            output_options=(--progress-bar)
        else
            output_options=(--silent)
        fi

        if curl --fail --show-error "${output_options[@]}" --location \
            --connect-timeout 15 "$@" "$url" -o "$destination"; then
            return 0
        else
            status=$?
        fi
        if ((attempt == max_attempts)); then
            die "download failed after $max_attempts attempts (curl exit $status): $url"
            return "$status"
        fi
        printf 'Download failed (attempt %s/%s); retrying...\n' "$attempt" "$max_attempts" >&2
        sleep "$attempt"
        attempt=$((attempt + 1))
    done
}

download_file() {
    local url="$1"
    local destination="$2"
    local progress_label="${3-}"

    case "$url" in
        https://api.github.com/*|https://github.com/*|https://getcomposer.org/*|https://composer.github.io/*) ;;
        *)
            die "refusing download from unsupported URL: $url"
            return 1
            ;;
    esac

    curl_to_file "$url" "$destination" "$progress_label"
}

verify_checksum() {
    local algorithm="$1"
    local expected="$2"
    local file="$3"
    local actual

    actual="$(calculate_checksum "$algorithm" "$file")" || return 1
    if [[ "$actual" != "$expected" ]]; then
        printf 'Error: %s checksum mismatch.\nExpected: %s\nActual:   %s\n' \
            "$algorithm" "$expected" "$actual" >&2
        return 1
    fi
}

install_locked_frankenphp() {
    local staging="$1"
    local runtime_dir="$staging/runtime"
    local download="$runtime_dir/frankenphp.download"
    local url

    mkdir -p "$runtime_dir"
    select_locked_asset || return 1
    url="https://github.com/php/frankenphp/releases/download/v$LOCK_FRANKENPHP_VERSION/$ASSET_NAME"
    download_file "$url" "$download" "FrankenPHP $LOCK_FRANKENPHP_VERSION" || return 1
    verify_checksum sha256 "$ASSET_SHA256" "$download" || return 1
    mv -- "$download" "$runtime_dir/frankenphp"
    chmod 755 "$runtime_dir/frankenphp"
}

install_locked_composer() {
    local staging="$1"
    local runtime_dir="$staging/runtime"
    local setup="$staging/composer-setup.php"
    local output

    if [[ ! -x "$runtime_dir/frankenphp" ]]; then
        die 'FrankenPHP must be installed before Composer'
        return 1
    fi
    download_file 'https://getcomposer.org/installer' "$setup" 'Composer installer' || return 1
    verify_checksum sha384 "$LOCK_COMPOSER_INSTALLER_SHA384" "$setup" || return 1
    "$runtime_dir/frankenphp" php-cli "$setup" \
        --quiet \
        "--version=$LOCK_COMPOSER_VERSION" \
        "--install-dir=$runtime_dir" \
        --filename=composer.phar || return 1
    if [[ ! -f "$runtime_dir/composer.phar" || -L "$runtime_dir/composer.phar" ]]; then
        die 'Composer installer did not create a regular composer.phar'
        return 1
    fi
    verify_checksum sha256 "$LOCK_COMPOSER_SHA256" \
        "$runtime_dir/composer.phar" || return 1
    output="$("$runtime_dir/frankenphp" php-cli \
        "$runtime_dir/composer.phar" --version)" || return 1
    if [[ "$output" != "Composer version $LOCK_COMPOSER_VERSION"* ]]; then
        die "installed Composer version does not match wari.lock: $output"
        return 1
    fi
    rm -f -- "$setup"
}

json_escape() {
    local value="$1"

    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\t'/\\t}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\n'/\\n}"
    printf '%s' "$value"
}

write_manifest() {
    local wari_dir="$1"
    local installed_at
    local linux_build_json='null'
    local asset_url

    installed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    if [[ "$PLATFORM_OS" == 'linux' ]]; then
        linux_build_json="\"$(json_escape "$LOCK_LINUX_BUILD")\""
    fi
    asset_url="https://github.com/php/frankenphp/releases/download/v$LOCK_FRANKENPHP_VERSION/$ASSET_NAME"

    printf '%s\n' "$WARI_RUNTIME_OWNER" >"$wari_dir/.wari-owned"
    {
        printf '{\n'
        printf '  "layout_version": 2,\n'
        printf '  "lock_sha256": "%s",\n' "$(json_escape "$LOCK_SHA256")"
        printf '  "wari_version": "%s",\n' "$(json_escape "$LOCK_WARI_VERSION")"
        printf '  "frankenphp_version": "%s",\n' "$(json_escape "$INSTALLED_FRANKENPHP_VERSION")"
        printf '  "php_version": "%s",\n' "$(json_escape "$INSTALLED_PHP_VERSION")"
        printf '  "composer_version": "%s",\n' "$(json_escape "$INSTALLED_COMPOSER_VERSION")"
        printf '  "os": "%s",\n' "$(json_escape "$PLATFORM_OS")"
        printf '  "architecture": "%s",\n' "$(json_escape "$PLATFORM_ARCH")"
        printf '  "linux_build": %s,\n' "$linux_build_json"
        printf '  "asset": "%s",\n' "$(json_escape "$ASSET_NAME")"
        printf '  "asset_url": "%s",\n' "$(json_escape "$asset_url")"
        printf '  "asset_sha256": "%s",\n' "$(json_escape "$ASSET_SHA256")"
        printf '  "composer_sha256": "%s",\n' "$(json_escape "$LOCK_COMPOSER_SHA256")"
        printf '  "checksum_verified": true,\n'
        printf '  "slsa_verified": false,\n'
        printf '  "installed_at": "%s"\n' "$(json_escape "$installed_at")"
        printf '}\n'
    } >"$wari_dir/manifest.json"
}

run_staged_smoke_checks() {
    local wari_dir="$1"

    "$wari_dir/php" --version >/dev/null
    "$wari_dir/composer" --version >/dev/null
    "$wari_dir/create-project" --help >/dev/null
    "$wari_dir/frankenphp" version >/dev/null
    "$wari_dir/php" -r \
        '$data = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR); exit(is_array($data) ? 0 : 1);' \
        "$wari_dir/manifest.json" >/dev/null
}

detect_installed_versions() {
    local wari_dir="$1"
    local output

    output="$("$wari_dir/php" --version)" || return 1
    INSTALLED_PHP_VERSION="$(printf '%s\n' "$output" | sed -n \
        's/^PHP \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | sed -n '1p')"
    output="$("$wari_dir/frankenphp" version)" || return 1
    INSTALLED_FRANKENPHP_VERSION="$(printf '%s\n' "$output" | sed -n \
        's/.*FrankenPHP v\{0,1\}\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | sed -n '1p')"
    output="$("$wari_dir/composer" --version)" || return 1
    INSTALLED_COMPOSER_VERSION="$(printf '%s\n' "$output" | sed -n \
        's/^Composer version \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | sed -n '1p')"
    [[ -n "$INSTALLED_PHP_VERSION" &&
        "$INSTALLED_FRANKENPHP_VERSION" == "$LOCK_FRANKENPHP_VERSION" &&
        "$INSTALLED_COMPOSER_VERSION" == "$LOCK_COMPOSER_VERSION" ]] || {
        die 'installed runtime versions do not match wari.lock'
        return 1
    }
}

is_safe_setup_path() {
    local project_root="$1"
    local path="$2"
    local prefix="$3"
    local parent
    local base

    [[ -n "$project_root" && -n "$path" ]] || return 1
    parent="$(dirname -- "$path")"
    base="$(basename -- "$path")"
    [[ "$parent" == "$project_root" && "$base" == "$prefix".?* ]]
}

is_recognized_runtime() {
    local runtime_dir="$1"

    [[ -d "$runtime_dir" && ! -L "$runtime_dir" &&
        -f "$runtime_dir/.wari-owned" && ! -L "$runtime_dir/.wari-owned" &&
        -f "$runtime_dir/manifest.json" && ! -L "$runtime_dir/manifest.json" ]] || return 1
    [[ "$(<"$runtime_dir/.wari-owned")" == "$WARI_RUNTIME_OWNER" &&
        "$(manifest_integer "$runtime_dir/manifest.json" layout_version)" == '2' ]]
}

cleanup_setup() {
    local status=$?

    if [[ "${NEW_RUNTIME_PUBLISHED:-0}" -eq 1 &&
        "${OLD_RUNTIME_BACKED_UP:-0}" -eq 1 ]]; then
        if is_recognized_runtime "$WARI_PROJECT_ROOT/.wari" &&
            is_safe_setup_path "$WARI_PROJECT_ROOT" "$RUNTIME_BACKUP" '.wari-backup'; then
            rm -rf -- "$WARI_PROJECT_ROOT/.wari"
            mv -- "$RUNTIME_BACKUP" "$WARI_PROJECT_ROOT/.wari"
            OLD_RUNTIME_BACKED_UP=0
        fi
    elif [[ "${NEW_RUNTIME_PUBLISHED:-0}" -eq 1 &&
        "${OLD_RUNTIME_BACKED_UP:-0}" -eq 0 ]]; then
        if is_recognized_runtime "$WARI_PROJECT_ROOT/.wari"; then
            rm -rf -- "$WARI_PROJECT_ROOT/.wari"
        fi
    fi
    if [[ -n "${SETUP_STAGING:-}" && -d "$SETUP_STAGING" ]] &&
        is_safe_setup_path "$WARI_PROJECT_ROOT" "$SETUP_STAGING" '.wari-install'; then
        rm -rf -- "$SETUP_STAGING"
    fi
    if [[ "${OLD_RUNTIME_BACKED_UP:-0}" -eq 1 ]] &&
        is_safe_setup_path "$WARI_PROJECT_ROOT" "$RUNTIME_BACKUP" '.wari-backup'; then
        mv -- "$RUNTIME_BACKUP" "$WARI_PROJECT_ROOT/.wari" 2>/dev/null || true
    fi
    if [[ "${SETUP_LOCK_OWNED:-0}" -eq 1 &&
        "$SETUP_LOCK" == "$WARI_PROJECT_ROOT/.wari-setup.lock" ]]; then
        rm -rf -- "$SETUP_LOCK"
    fi
    exit "$status"
}

confirm_setup() {
    local answer

    if ! { exec 3</dev/tty 4>/dev/tty; } 2>/dev/null; then
        die 'setup requires confirmation; pass --yes for automation'
        return 2
    fi
    printf 'Install or replace this project local Wari runtime? [y/N]: ' >&4
    IFS= read -r answer <&3 || return 2
    case "$answer" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

setup_main() (
    local assume_yes=0
    local argument

    for argument in "$@"; do
        case "$argument" in
            --yes) assume_yes=1 ;;
            --help|-h)
                printf '%s\n' 'Usage: ./wari setup [--yes]'
                return 0
                ;;
            *) die "unknown setup option: $argument"; return 2 ;;
        esac
    done

    WARI_PROJECT_ROOT="${WARI_PROJECT_ROOT:-$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
    WARI_RUNTIME_DIR="$WARI_PROJECT_ROOT/.wari"
    parse_lock "$WARI_PROJECT_ROOT/wari.lock" || return 1
    detect_current_platform || return 1
    if [[ "$PLATFORM_OS" == 'linux' && "$LOCK_LINUX_BUILD" == 'gnu' ]] &&
        ! has_glibc; then
        die 'GNU Wari runtime requires glibc; use a lock generated for the static build'
        return 1
    fi
    LOCK_SHA256="$(lock_digest "$WARI_PROJECT_ROOT/wari.lock")" || return 1

    if [[ -e "$WARI_RUNTIME_DIR" || -L "$WARI_RUNTIME_DIR" ]]; then
        if validate_runtime "$WARI_PROJECT_ROOT" >/dev/null 2>&1; then
            printf 'Wari runtime is already ready.\n'
            return 0
        fi
        if ! is_recognized_runtime "$WARI_RUNTIME_DIR"; then
            die '.wari/ exists but is not recognized as a Wari runtime'
            return 1
        fi
    fi

    if [[ "$assume_yes" -ne 1 ]]; then
        if confirm_setup; then
            :
        else
            confirm_status=$?
            if [[ "$confirm_status" -eq 1 ]]; then
                printf 'Wari setup cancelled.\n'
                return 0
            fi
            return 1
        fi
    fi

    SETUP_LOCK="$WARI_PROJECT_ROOT/.wari-setup.lock"
    SETUP_LOCK_OWNED=0
    SETUP_STAGING=''
    RUNTIME_BACKUP=''
    OLD_RUNTIME_BACKED_UP=0
    NEW_RUNTIME_PUBLISHED=0
    trap cleanup_setup EXIT
    trap '' INT TERM HUP
    if ! mkdir -- "$SETUP_LOCK" 2>/dev/null; then
        die 'another Wari setup is already running'
        return 1
    fi
    SETUP_LOCK_OWNED=1
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    printf '%s\n' "$$" >"$SETUP_LOCK/pid" || return 1
    SETUP_STAGING="$(mktemp -d "$WARI_PROJECT_ROOT/.wari-install.XXXXXX")" || return $?

    install_locked_frankenphp "$SETUP_STAGING" || return 1
    install_locked_composer "$SETUP_STAGING" || return 1
    generate_wrappers "$SETUP_STAGING" || return 1
    detect_installed_versions "$SETUP_STAGING" || return 1
    write_manifest "$SETUP_STAGING" || return 1
    run_staged_smoke_checks "$SETUP_STAGING" || return 1

    if [[ -d "$WARI_RUNTIME_DIR" ]]; then
        RUNTIME_BACKUP="$(mktemp -d "$WARI_PROJECT_ROOT/.wari-backup.XXXXXX")"
        rmdir -- "$RUNTIME_BACKUP"
        mv -- "$WARI_RUNTIME_DIR" "$RUNTIME_BACKUP" || return 1
        OLD_RUNTIME_BACKED_UP=1
    fi
    mv -- "$SETUP_STAGING" "$WARI_RUNTIME_DIR" || return 1
    SETUP_STAGING=''
    NEW_RUNTIME_PUBLISHED=1
    validate_runtime "$WARI_PROJECT_ROOT" || return 1

    if [[ "$OLD_RUNTIME_BACKED_UP" -eq 1 ]]; then
        rm -rf -- "$RUNTIME_BACKUP"
        OLD_RUNTIME_BACKED_UP=0
    fi
    rm -rf -- "$SETUP_LOCK"
    SETUP_LOCK_OWNED=0
    NEW_RUNTIME_PUBLISHED=0
    trap - EXIT INT TERM HUP
    printf 'Wari runtime is ready.\n'
)

read_wari_release_asset() {
    local json_file="$1"
    local asset_name="$2"
    local record
    local digest
    local url

    record="$(awk -v target="$asset_name" '
        function string_value(line, value) {
            value = line
            sub(/^[^:]*:[[:space:]]*"/, "", value)
            sub(/"[,]*[[:space:]]*$/, "", value)
            return value
        }
        /^[[:space:]]*"name":[[:space:]]*"/ {
            value = string_value($0)
            if (value == target) { matches++; active = 1 } else { active = 0 }
            next
        }
        active && /^[[:space:]]*"digest":[[:space:]]*"/ {
            digest = string_value($0); next
        }
        active && /^[[:space:]]*"browser_download_url":[[:space:]]*"/ {
            url = string_value($0); active = 0
        }
        END {
            if (matches != 1 || digest == "" || url == "") exit 2
            printf "%s\t%s\n", digest, url
        }
    ' "$json_file")" || return 1
    IFS=$'\t' read -r digest url <<<"$record"
    [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    printf '%s\t%s\n' "${digest#sha256:}" "$url"
}

parse_wari_release() {
    local json_file="$1"
    local header
    local wari_record
    local lock_record

    header="$(awk '
        function string_value(line, value) {
            value = line
            sub(/^[^:]*:[[:space:]]*"/, "", value)
            sub(/"[,]*[[:space:]]*$/, "", value)
            return value
        }
        function scalar_value(line, value) {
            value = line
            sub(/^[^:]*:[[:space:]]*/, "", value)
            sub(/[,]*[[:space:]]*$/, "", value)
            return value
        }
        /^[[:space:]]*"tag_name":/ { tags++; tag = string_value($0) }
        /^[[:space:]]*"draft":/ { drafts++; draft = scalar_value($0) }
        /^[[:space:]]*"prerelease":/ { pres++; pre = scalar_value($0) }
        END {
            if (tags != 1 || drafts != 1 || pres != 1) exit 2
            printf "%s\t%s\t%s\n", tag, draft, pre
        }
    ' "$json_file")" || { die 'invalid Wari release metadata'; return 1; }
    IFS=$'\t' read -r WARI_RELEASE_TAG release_draft release_prerelease <<<"$header"
    [[ "$WARI_RELEASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ &&
        "$release_draft" == 'false' && "$release_prerelease" == 'false' ]] || {
        die 'Wari release must be a stable semantic version'
        return 1
    }

    wari_record="$(read_wari_release_asset "$json_file" wari)" || return 1
    lock_record="$(read_wari_release_asset "$json_file" wari.lock)" || return 1
    IFS=$'\t' read -r WARI_ASSET_SHA256 WARI_ASSET_URL <<<"$wari_record"
    IFS=$'\t' read -r WARI_LOCK_ASSET_SHA256 WARI_LOCK_ASSET_URL <<<"$lock_record"
    [[ "$WARI_ASSET_URL" == \
        "https://github.com/wednesdaymoonlab/wari/releases/download/$WARI_RELEASE_TAG/wari" &&
        "$WARI_LOCK_ASSET_URL" == \
        "https://github.com/wednesdaymoonlab/wari/releases/download/$WARI_RELEASE_TAG/wari.lock" ]] || {
        die 'Wari release asset URL is not official'
        return 1
    }
}


fetch_wari_update() {
    local staging="$1"
    local release_json="$staging/wari-release.json"

    download_file \
        'https://api.github.com/repos/wednesdaymoonlab/wari/releases/latest' \
        "$release_json" || return 1
    parse_wari_release "$release_json" || return 1
    download_file "$WARI_ASSET_URL" "$staging/wari" 'Wari launcher' || return 1
    verify_checksum sha256 "$WARI_ASSET_SHA256" "$staging/wari" || return 1
    download_file "$WARI_LOCK_ASSET_URL" "$staging/wari.lock" 'Wari lock' || return 1
    verify_checksum sha256 "$WARI_LOCK_ASSET_SHA256" "$staging/wari.lock" || return 1
    rm -f -- "$release_json"
    chmod 755 "$staging/wari"
}

validate_launcher_pair() {
    local launcher="$1"
    local lock="$2"
    local actual_sha
    local reported_version

    parse_lock "$lock" || return 1
    actual_sha="$(calculate_checksum sha256 "$launcher")" || return 1
    [[ "$actual_sha" == "$LOCK_WARI_SHA256" ]] || {
        die 'tracked Wari launcher has local modifications or does not match wari.lock'
        return 1
    }
    reported_version="$(bash "$launcher" --version-value)" || return 1
    [[ "$reported_version" == "$LOCK_WARI_VERSION" ]] || {
        die 'Wari launcher version does not match wari.lock'
        return 1
    }
}

update_main() (
    local assume_yes=0
    local current_version
    local candidate_version
    local staging
    local launcher_published=0
    local lock_published=0

    case "${1-}" in
        --yes) assume_yes=1; shift ;;
        --help|-h)
            printf '%s\n' 'Usage: ./wari update [--yes]'
            return 0
            ;;
    esac
    [[ "$#" -eq 0 ]] || { die "unknown update option: $1"; return 2; }

    WARI_PROJECT_ROOT="${WARI_PROJECT_ROOT:-$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
    WARI_LAUNCHER="${WARI_LAUNCHER:-$WARI_PROJECT_ROOT/wari}"
    validate_launcher_pair "$WARI_LAUNCHER" "$WARI_PROJECT_ROOT/wari.lock" || return 1
    current_version="$LOCK_WARI_VERSION"

    staging="$(mktemp -d "$WARI_PROJECT_ROOT/.wari-update.XXXXXX")"
    cleanup_update() {
        local status=$?
        if [[ "$lock_published" -eq 1 && -f "$staging/wari.lock.old" ]]; then
            cp "$staging/wari.lock.old" "$WARI_PROJECT_ROOT/wari.lock" || true
        fi
        if [[ "$launcher_published" -eq 1 && -f "$staging/wari.old" ]]; then
            cp "$staging/wari.old" "$WARI_LAUNCHER" || true
            chmod 755 "$WARI_LAUNCHER" || true
        fi
        case "$staging" in
            "$WARI_PROJECT_ROOT"/.wari-update.?*) rm -rf -- "$staging" ;;
        esac
        exit "$status"
    }
    trap cleanup_update EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP

    fetch_wari_update "$staging" || return 1
    validate_launcher_pair "$staging/wari" "$staging/wari.lock" || return 1
    candidate_version="$LOCK_WARI_VERSION"
    printf 'Wari update: %s -> %s\n' "$current_version" "$candidate_version"

    if [[ "$assume_yes" -ne 1 ]]; then
        if confirm_setup; then
            :
        else
            confirm_status=$?
            if [[ "$confirm_status" -eq 1 ]]; then
                printf 'Wari update cancelled.\n'
                return 0
            fi
            return 1
        fi
    fi

    cp "$WARI_LAUNCHER" "$staging/wari.old"
    cp "$WARI_PROJECT_ROOT/wari.lock" "$staging/wari.lock.old"
    mv -- "$staging/wari" "$WARI_LAUNCHER" || return 1
    chmod 755 "$WARI_LAUNCHER"
    launcher_published=1
    mv -- "$staging/wari.lock" "$WARI_PROJECT_ROOT/wari.lock" || return 1
    lock_published=1
    validate_launcher_pair "$WARI_LAUNCHER" "$WARI_PROJECT_ROOT/wari.lock" || return 1

    rm -rf -- "$staging"
    launcher_published=0
    lock_published=0
    trap - EXIT INT TERM HUP
    printf '%s\n' '' 'Review the tracked changes, then run:' '  ./wari setup'
)

