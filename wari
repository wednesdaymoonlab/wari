#!/usr/bin/env bash
set -Eeuo pipefail

WARI_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_ROOT="$(dirname -- "$WARI_DIR")"
cd -- "$PROJECT_ROOT"

