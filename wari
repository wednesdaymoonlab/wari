STAGING_PREFIX=''
CURRENT_SOURCE=''
CURRENT_DESTINATION=''
CREATE_PROJECT_COMPLETE=0
IGNORE_BACKED_UP=0
IGNORE_REPLACED=0
IGNORE_BACKUP=''
PUBLISHED_ENTRIES=()

write_wari_ignore_block() {
    printf '%s\n' \
        '# Wari local runtime' \
        '/.wari/' \
        '/.wari-install.*' \
        '/.wari-backup.*' \
        '/.wari-update.*' \
        '/.wari-setup.lock'
