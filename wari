    PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$WARI_DIR")" && pwd -P)"
fi
PROJECT_PARENT="$(CDPATH= cd -- "$(dirname -- "$PROJECT_ROOT")" && pwd -P)"
PROJECT_NAME="${PROJECT_ROOT##*/}"

create_project_main "$@"
WARI_CREATE_PROJECT

    cat >"$wari_dir/serve" <<'WARI_SERVE'
