#!/usr/bin/env bash

set -Eeuo pipefail

WARI_VERSION='0.3.0'
WARI_RUNTIME_OWNER='Wari runtime layout 2'

die() {
    printf 'Error: %s\n' "$1" >&2
    return 1
}

validate_semver() {
    [[ "${1-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
        die "invalid semantic version: ${1-}"
        return 1
    }
}

reset_lock_state() {
    LOCK_VERSION=''
    LOCK_WARI_VERSION=''
    LOCK_FRANKENPHP_VERSION=''
    LOCK_COMPOSER_VERSION=''
    LOCK_LINUX_BUILD=''
    LOCK_WARI_SHA256=''
    LOCK_COMPOSER_INSTALLER_SHA384=''
    LOCK_COMPOSER_SHA256=''
    LOCK_FRANKENPHP_LINUX_X86_64_SHA256=''
    LOCK_FRANKENPHP_LINUX_ARM64_SHA256=''
    LOCK_FRANKENPHP_MACOS_X86_64_SHA256=''
    LOCK_FRANKENPHP_MACOS_ARM64_SHA256=''

    SEEN_LOCK_VERSION=0
    SEEN_WARI_VERSION=0
    SEEN_FRANKENPHP_VERSION=0
    SEEN_COMPOSER_VERSION=0
    SEEN_LINUX_BUILD=0
    SEEN_WARI_SHA256=0
    SEEN_COMPOSER_INSTALLER_SHA384=0
    SEEN_COMPOSER_SHA256=0
    SEEN_FRANKENPHP_LINUX_X86_64_SHA256=0
    SEEN_FRANKENPHP_LINUX_ARM64_SHA256=0
    SEEN_FRANKENPHP_MACOS_X86_64_SHA256=0
    SEEN_FRANKENPHP_MACOS_ARM64_SHA256=0
}

assign_lock_value() {
    local key="$1"
    local value="$2"

    case "$key" in
        lock_version)
            [[ "$SEEN_LOCK_VERSION" -eq 0 ]] || return 1
            SEEN_LOCK_VERSION=1
            LOCK_VERSION="$value"
            ;;
        wari_version)
            [[ "$SEEN_WARI_VERSION" -eq 0 ]] || return 1
            SEEN_WARI_VERSION=1
            LOCK_WARI_VERSION="$value"
            ;;
        frankenphp_version)
            [[ "$SEEN_FRANKENPHP_VERSION" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_VERSION=1
            LOCK_FRANKENPHP_VERSION="$value"
            ;;
        composer_version)
            [[ "$SEEN_COMPOSER_VERSION" -eq 0 ]] || return 1
            SEEN_COMPOSER_VERSION=1
            LOCK_COMPOSER_VERSION="$value"
            ;;
        linux_build)
            [[ "$SEEN_LINUX_BUILD" -eq 0 ]] || return 1
            SEEN_LINUX_BUILD=1
            LOCK_LINUX_BUILD="$value"
            ;;
        wari_sha256)
            [[ "$SEEN_WARI_SHA256" -eq 0 ]] || return 1
            SEEN_WARI_SHA256=1
            LOCK_WARI_SHA256="$value"
            ;;
        composer_installer_sha384)
            [[ "$SEEN_COMPOSER_INSTALLER_SHA384" -eq 0 ]] || return 1
            SEEN_COMPOSER_INSTALLER_SHA384=1
            LOCK_COMPOSER_INSTALLER_SHA384="$value"
            ;;
        composer_sha256)
            [[ "$SEEN_COMPOSER_SHA256" -eq 0 ]] || return 1
            SEEN_COMPOSER_SHA256=1
            LOCK_COMPOSER_SHA256="$value"
            ;;
        frankenphp_linux_x86_64_sha256)
            [[ "$SEEN_FRANKENPHP_LINUX_X86_64_SHA256" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_LINUX_X86_64_SHA256=1
            LOCK_FRANKENPHP_LINUX_X86_64_SHA256="$value"
            ;;
        frankenphp_linux_arm64_sha256)
            [[ "$SEEN_FRANKENPHP_LINUX_ARM64_SHA256" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_LINUX_ARM64_SHA256=1
            LOCK_FRANKENPHP_LINUX_ARM64_SHA256="$value"
            ;;
        frankenphp_macos_x86_64_sha256)
            [[ "$SEEN_FRANKENPHP_MACOS_X86_64_SHA256" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_MACOS_X86_64_SHA256=1
            LOCK_FRANKENPHP_MACOS_X86_64_SHA256="$value"
            ;;
        frankenphp_macos_arm64_sha256)
            [[ "$SEEN_FRANKENPHP_MACOS_ARM64_SHA256" -eq 0 ]] || return 1
            SEEN_FRANKENPHP_MACOS_ARM64_SHA256=1
            LOCK_FRANKENPHP_MACOS_ARM64_SHA256="$value"
            ;;
        *)
            die "unknown Wari lock key: $key"
            return 1
            ;;
    esac
}

validate_complete_lock() {
    local seen

    for seen in \
        "$SEEN_LOCK_VERSION" \
        "$SEEN_WARI_VERSION" \
        "$SEEN_FRANKENPHP_VERSION" \
        "$SEEN_COMPOSER_VERSION" \
        "$SEEN_LINUX_BUILD" \
        "$SEEN_WARI_SHA256" \
        "$SEEN_COMPOSER_INSTALLER_SHA384" \
        "$SEEN_COMPOSER_SHA256" \
        "$SEEN_FRANKENPHP_LINUX_X86_64_SHA256" \
        "$SEEN_FRANKENPHP_LINUX_ARM64_SHA256" \
        "$SEEN_FRANKENPHP_MACOS_X86_64_SHA256" \
        "$SEEN_FRANKENPHP_MACOS_ARM64_SHA256"; do
        if [[ "$seen" -ne 1 ]]; then
            die 'Wari lock is missing one or more required keys'
            return 1
        fi
    done

    [[ "$LOCK_VERSION" == '1' ]] || {
        die "unsupported Wari lock version: $LOCK_VERSION"
        return 1
    }
    [[ "$LOCK_WARI_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    [[ "$LOCK_COMPOSER_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    [[ "$LOCK_LINUX_BUILD" == 'static' || "$LOCK_LINUX_BUILD" == 'gnu' ]] || return 1
    [[ "$LOCK_WARI_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_COMPOSER_INSTALLER_SHA384" =~ ^[0-9a-f]{96}$ ]] || return 1
    [[ "$LOCK_COMPOSER_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_LINUX_X86_64_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_LINUX_ARM64_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_MACOS_X86_64_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$LOCK_FRANKENPHP_MACOS_ARM64_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
}

parse_lock() {
    local path="$1"
    local line
    local key
    local value

    if [[ ! -f "$path" || -L "$path" ]]; then
        die "invalid Wari lock: $path"
        return 1
    fi

    reset_lock_state
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ ! "$line" =~ ^[a-z0-9_]+=[^[:space:][:cntrl:]]+$ ]]; then
            die 'invalid Wari lock line'
            return 1
        fi
        key="${line%%=*}"
        value="${line#*=}"
        assign_lock_value "$key" "$value" || return 1
    done <"$path"

    validate_complete_lock
}

select_locked_asset() {
    case "${PLATFORM_OS:-}/${PLATFORM_ARCH:-}" in
        linux/x86_64)
            ASSET_NAME='frankenphp-linux-x86_64'
            [[ "$LOCK_LINUX_BUILD" == 'static' ]] || ASSET_NAME="$ASSET_NAME-gnu"
            ASSET_SHA256="$LOCK_FRANKENPHP_LINUX_X86_64_SHA256"
            ;;
        linux/arm64)
            ASSET_NAME='frankenphp-linux-aarch64'
            [[ "$LOCK_LINUX_BUILD" == 'static' ]] || ASSET_NAME="$ASSET_NAME-gnu"
            ASSET_SHA256="$LOCK_FRANKENPHP_LINUX_ARM64_SHA256"
            ;;
        darwin/x86_64)
            ASSET_NAME='frankenphp-mac-x86_64'
            ASSET_SHA256="$LOCK_FRANKENPHP_MACOS_X86_64_SHA256"
            ;;
        darwin/arm64)
            ASSET_NAME='frankenphp-mac-arm64'
            ASSET_SHA256="$LOCK_FRANKENPHP_MACOS_ARM64_SHA256"
            ;;
        *)
            die "unsupported Wari platform: ${PLATFORM_OS:-unknown} ${PLATFORM_ARCH:-unknown}"
            return 1
            ;;
    esac
}

has_glibc() {
    local output

    if command -v getconf >/dev/null 2>&1; then
        output="$(getconf GNU_LIBC_VERSION 2>/dev/null || true)"
        [[ "$output" == glibc\ * ]] && return 0
    fi
    if command -v ldd >/dev/null 2>&1; then
        output="$(ldd --version 2>&1 || true)"
        [[ "$output" == *glibc* || "$output" == *GLIBC* ||
            "$output" == *'GNU libc'* ]] && return 0
    fi
    return 1
}

can_show_download_progress() {
    [[ -t 2 ]]
}

curl_to_file() {
    local url="$1"
    local destination="$2"
    local progress_label="$3"
    shift 3
    local attempt=1
    local max_attempts=4
    local status
    local effective_url
    local -a output_options

    while ((attempt <= max_attempts)); do
        if [[ -n "$progress_label" ]] && can_show_download_progress; then
            if ((attempt == 1)); then
                printf 'Downloading %s\n' "$progress_label" >&2
            else
                printf 'Downloading %s (attempt %s/%s)\n' \
                    "$progress_label" "$attempt" "$max_attempts" >&2
            fi
            output_options=(--progress-bar)
        else
            output_options=(--silent)
        fi

        if effective_url="$(curl --fail --show-error "${output_options[@]}" \
            --location --proto '=https' --proto-redir '=https' \
            --write-out '%{url_effective}' --connect-timeout 15 \
            "$@" "$url" -o "$destination")"; then
            if validate_effective_download_url "$url" "$effective_url"; then
                return 0
            fi
            rm -f -- "$destination"
            return 1
        else
            status=$?
        fi
        if ((attempt == max_attempts)); then
            die "download failed after $max_attempts attempts (curl exit $status): $url"
            return "$status"
        fi
        printf 'Download failed (attempt %s/%s); retrying...\n' "$attempt" "$max_attempts" >&2
        sleep "$attempt"
        attempt=$((attempt + 1))
    done
}

validate_effective_download_url() {
    local initial_url="$1"
    local effective_url="$2"

    case "$initial_url" in
        https://api.github.com/*)
            [[ "$effective_url" == https://api.github.com/* ]]
            ;;
        https://github.com/php/frankenphp/releases/download/*)
            [[ "$effective_url" == "$initial_url" ||
                "$effective_url" == https://release-assets.githubusercontent.com/* ]]
            ;;
        https://getcomposer.org/*)
            [[ "$effective_url" == https://getcomposer.org/* ]]
            ;;
        https://composer.github.io/*)
            [[ "$effective_url" == https://composer.github.io/* ]]
            ;;
        https://raw.githubusercontent.com/wednesdaymoonlab/wari/*)
            [[ "$effective_url" == "$initial_url" ]]
            ;;
        *) return 1 ;;
    esac || {
        die "download redirected to an unsupported URL: $effective_url"
        return 1
    }
}

download_file() {
    local url="$1"
    local destination="$2"
    local progress_label="${3-}"

    case "$url" in
        https://api.github.com/*|https://github.com/*|https://getcomposer.org/*|\
        https://composer.github.io/*|\
        https://raw.githubusercontent.com/wednesdaymoonlab/wari/*) ;;
        *)
            die "refusing download from unsupported URL: $url"
            return 1
            ;;
    esac

    curl_to_file "$url" "$destination" "$progress_label"
}

read_frankenphp_release_asset() {
    local json_file="$1"
    local version="$2"
    local asset_name="$3"
    local record
    local digest
    local url
    local expected_url

    record="$(awk -v target="$asset_name" '
        function string_value(line, value) {
            value = line
            sub(/^[^:]*:[[:space:]]*"/, "", value)
            sub(/"[,]*[[:space:]]*$/, "", value)
            return value
        }
        /^[[:space:]]*"name":[[:space:]]*"/ {
            value = string_value($0)
            if (value == target) { matches++; active = 1 } else { active = 0 }
            next
        }
        active && /^[[:space:]]*"digest":[[:space:]]*"/ {
            digest = string_value($0)
            next
        }
        active && /^[[:space:]]*"browser_download_url":[[:space:]]*"/ {
            url = string_value($0)
            active = 0
        }
        END {
            if (matches != 1 || digest == "" || url == "") exit 2
            printf "%s\t%s\n", digest, url
        }
    ' "$json_file")" || {
        die "FrankenPHP release metadata has no unique complete asset named $asset_name"
        return 1
    }
    IFS=$'\t' read -r digest url <<<"$record"
    [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || {
        die "FrankenPHP release asset has an invalid digest: $asset_name"
        return 1
    }
    expected_url="https://github.com/php/frankenphp/releases/download/v$version/$asset_name"
    [[ "$url" == "$expected_url" ]] || {
        die "FrankenPHP release asset URL is not official: $asset_name"
        return 1
    }
    printf '%s\n' "${digest#sha256:}"
}

parse_frankenphp_release() {
    local json_file="$1"
    local expected_version="$2"
    local linux_build="$3"
    local header
    local tag
    local draft
    local prerelease
    local linux_x86_asset='frankenphp-linux-x86_64'
    local linux_arm_asset='frankenphp-linux-aarch64'

    [[ "$linux_build" == static || "$linux_build" == gnu ]] || {
        die "invalid Linux build: $linux_build"
        return 1
    }
    header="$(awk '
        function string_value(line, value) {
            value = line
            sub(/^[^:]*:[[:space:]]*"/, "", value)
            sub(/"[,]*[[:space:]]*$/, "", value)
            return value
        }
        function scalar_value(line, value) {
            value = line
            sub(/^[^:]*:[[:space:]]*/, "", value)
            sub(/[,]*[[:space:]]*$/, "", value)
            return value
        }
        /^[[:space:]]*"tag_name":/ { tags++; tag = string_value($0) }
        /^[[:space:]]*"draft":/ { drafts++; draft = scalar_value($0) }
        /^[[:space:]]*"prerelease":/ { pres++; pre = scalar_value($0) }
        END {
            if (tags != 1 || drafts != 1 || pres != 1) exit 2
            printf "%s\t%s\t%s\n", tag, draft, pre
        }
    ' "$json_file")" || {
        die 'invalid FrankenPHP release metadata'
        return 1
    }
    IFS=$'\t' read -r tag draft prerelease <<<"$header"
    [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ &&
        "$draft" == false && "$prerelease" == false ]] || {
        die 'FrankenPHP release must be a stable semantic version'
        return 1
    }
    RESOLVED_FRANKENPHP_VERSION="${tag#v}"
    if [[ -n "$expected_version" &&
        "$RESOLVED_FRANKENPHP_VERSION" != "$expected_version" ]]; then
        die 'FrankenPHP release version does not match the requested version'
        return 1
    fi
    if [[ "$linux_build" == gnu ]]; then
        linux_x86_asset="$linux_x86_asset-gnu"
        linux_arm_asset="$linux_arm_asset-gnu"
    fi
    RESOLVED_FRANKENPHP_LINUX_X86_64_SHA256="$(read_frankenphp_release_asset \
        "$json_file" "$RESOLVED_FRANKENPHP_VERSION" "$linux_x86_asset")" || return 1
    RESOLVED_FRANKENPHP_LINUX_ARM64_SHA256="$(read_frankenphp_release_asset \
        "$json_file" "$RESOLVED_FRANKENPHP_VERSION" "$linux_arm_asset")" || return 1
    RESOLVED_FRANKENPHP_MACOS_X86_64_SHA256="$(read_frankenphp_release_asset \
        "$json_file" "$RESOLVED_FRANKENPHP_VERSION" 'frankenphp-mac-x86_64')" || return 1
    RESOLVED_FRANKENPHP_MACOS_ARM64_SHA256="$(read_frankenphp_release_asset \
        "$json_file" "$RESOLVED_FRANKENPHP_VERSION" 'frankenphp-mac-arm64')" || return 1
}

parse_composer_latest() {
    local json_file="$1"
    local record
    local path
    local version

    record="$(awk '
        function string_value(line, value) {
            value = line
            sub(/^[^:]*:[[:space:]]*"/, "", value)
            sub(/"[,]*[[:space:]]*$/, "", value)
            return value
        }
        /^[[:space:]]*"stable":[[:space:]]*\[/ {
            stable_sections++
            in_stable = 1
            next
        }
        in_stable && /^[[:space:]]*\]/ { in_stable = 0 }
        in_stable && !object_seen && /^[[:space:]]*\{/ {
            object_seen = 1
            in_first_object = 1
            next
        }
        in_first_object && /^[[:space:]]*\}/ {
            in_first_object = 0
            object_closed = 1
            next
        }
        in_first_object && /^[[:space:]]*"path":[[:space:]]*"/ {
            path_fields++
            path = string_value($0)
        }
        in_first_object && /^[[:space:]]*"version":[[:space:]]*"/ {
            version_fields++
            version = string_value($0)
        }
        END {
            if (stable_sections != 1 || !object_closed ||
                path_fields != 1 || version_fields != 1 ||
                path == "" || version == "") exit 2
            printf "%s\t%s\n", version, path
        }
    ' "$json_file")" || {
        die 'invalid Composer versions metadata'
        return 1
    }
    IFS=$'\t' read -r version path <<<"$record"
    validate_semver "$version" || return 1
    [[ "$path" == "/download/$version/composer.phar" ]] || {
        die 'Composer stable metadata has an invalid download path'
        return 1
    }
    RESOLVED_COMPOSER_VERSION="$version"
}

read_checksum_value() {
    local path="$1"
    local length="$2"
    local label="$3"
    local value

    value="$(awk '
        NF {
            lines++
            if (NF > 2 || (NF == 2 && $2 != "composer.phar")) invalid = 1
            checksum = $1
        }
        END {
            if (lines != 1 || invalid || checksum == "") exit 2
            print checksum
        }
    ' "$path")" || {
        die "$label checksum metadata is invalid"
        return 1
    }
    if [[ "$length" == 64 ]]; then
        [[ "$value" =~ ^[0-9a-f]{64}$ ]] || {
            die "$label checksum metadata is invalid"
            return 1
        }
    elif [[ "$length" == 96 ]]; then
        [[ "$value" =~ ^[0-9a-f]{96}$ ]] || {
            die "$label checksum metadata is invalid"
            return 1
        }
    else
        die "unsupported checksum metadata length: $length"
        return 1
    fi
    printf '%s\n' "$value"
}

generate_lock_file() (
    local launcher="$1"
    local requested_output="$2"
    local frankenphp_request="$3"
    local composer_request="$4"
    local linux_build="$5"
    local output_parent output_base output staging release_url release_json
    local composer_versions composer_sha_file installer_sha_file
    local launcher_version launcher_sha composer_sha installer_sha candidate

    [[ -f "$launcher" && ! -L "$launcher" ]] || {
        die "invalid Wari launcher: $launcher"
        return 1
    }
    [[ ! -L "$requested_output" &&
        ( ! -e "$requested_output" || -f "$requested_output" ) ]] || {
        die "invalid lock output: $requested_output"
        return 1
    }
    output_parent="$(CDPATH= cd -- "$(dirname -- "$requested_output")" && pwd -P)" || {
        die "invalid lock output parent: $requested_output"
        return 1
    }
    output_base="$(basename -- "$requested_output")"
    [[ "$output_base" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
        die "invalid lock output name: $output_base"
        return 1
    }
    output="$output_parent/$output_base"
    [[ ! -L "$output" && ( ! -e "$output" || -f "$output" ) ]] || {
        die "invalid lock output: $output"
        return 1
    }
    [[ "$linux_build" == static || "$linux_build" == gnu ]] || {
        die "invalid Linux build: $linux_build"
        return 1
    }
    [[ -z "$frankenphp_request" ]] || validate_semver "$frankenphp_request" || return 1
    [[ -z "$composer_request" ]] || validate_semver "$composer_request" || return 1

    launcher_version="$(bash "$launcher" --version-value)" || return 1
    validate_semver "$launcher_version" || return 1
    launcher_sha="$(calculate_checksum sha256 "$launcher")" || return 1

    staging="$(mktemp -d "$output_parent/.wari-lock.XXXXXX")" || return $?
    cleanup_generated_lock() {
        local status=$?
        case "$staging" in
            "$output_parent"/.wari-lock.?*) rm -rf -- "$staging" ;;
        esac
        exit "$status"
    }
    trap cleanup_generated_lock EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP

    release_json="$staging/frankenphp-release.json"
    if [[ -n "$frankenphp_request" ]]; then
        release_url="https://api.github.com/repos/php/frankenphp/releases/tags/v$frankenphp_request"
    else
        release_url='https://api.github.com/repos/php/frankenphp/releases/latest'
    fi
    download_file "$release_url" "$release_json" || return 1
    parse_frankenphp_release "$release_json" "$frankenphp_request" "$linux_build" || return 1

    if [[ -n "$composer_request" ]]; then
        RESOLVED_COMPOSER_VERSION="$composer_request"
    else
        composer_versions="$staging/composer-versions.json"
        download_file 'https://getcomposer.org/versions' "$composer_versions" || return 1
        parse_composer_latest "$composer_versions" || return 1
    fi
    composer_sha_file="$staging/composer.sha256sum"
    download_file \
        "https://getcomposer.org/download/$RESOLVED_COMPOSER_VERSION/composer.phar.sha256sum" \
        "$composer_sha_file" || return 1
    composer_sha="$(read_checksum_value "$composer_sha_file" 64 Composer)" || return 1
    installer_sha_file="$staging/composer-installer.sig"
    download_file 'https://composer.github.io/installer.sig' "$installer_sha_file" || return 1
    installer_sha="$(read_checksum_value "$installer_sha_file" 96 'Composer installer')" || return 1

    candidate="$staging/wari.lock"
    {
        printf 'lock_version=1\n'
        printf 'wari_version=%s\n' "$launcher_version"
        printf 'frankenphp_version=%s\n' "$RESOLVED_FRANKENPHP_VERSION"
        printf 'composer_version=%s\n' "$RESOLVED_COMPOSER_VERSION"
        printf 'linux_build=%s\n' "$linux_build"
        printf 'wari_sha256=%s\n' "$launcher_sha"
        printf 'composer_installer_sha384=%s\n' "$installer_sha"
        printf 'composer_sha256=%s\n' "$composer_sha"
        printf 'frankenphp_linux_x86_64_sha256=%s\n' \
            "$RESOLVED_FRANKENPHP_LINUX_X86_64_SHA256"
        printf 'frankenphp_linux_arm64_sha256=%s\n' \
            "$RESOLVED_FRANKENPHP_LINUX_ARM64_SHA256"
        printf 'frankenphp_macos_x86_64_sha256=%s\n' \
            "$RESOLVED_FRANKENPHP_MACOS_X86_64_SHA256"
        printf 'frankenphp_macos_arm64_sha256=%s\n' \
            "$RESOLVED_FRANKENPHP_MACOS_ARM64_SHA256"
    } >"$candidate" || return 1
    validate_launcher_pair "$launcher" "$candidate" || return 1
    mv -- "$candidate" "$output" || return 1
    rm -rf -- "$staging"
    trap - EXIT INT TERM HUP
)

generate_lock_main() {
    local output="${1-}"
    local frankenphp_request=''
    local composer_request=''
    local linux_build='static'
    local seen_frankenphp=0 seen_composer=0 seen_linux_build=0
    local launcher

    [[ -n "$output" ]] || {
        die 'Usage: ./wari --generate-lock OUTPUT [--frankenphp VERSION] [--composer VERSION] [--linux-build static|gnu]'
        return 2
    }
    shift
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --frankenphp)
                [[ "$seen_frankenphp" -eq 0 && "$#" -ge 2 ]] || {
                    die 'invalid or duplicate --frankenphp option'
                    return 2
                }
                seen_frankenphp=1
                frankenphp_request="$2"
                shift 2
                ;;
            --composer)
                [[ "$seen_composer" -eq 0 && "$#" -ge 2 ]] || {
                    die 'invalid or duplicate --composer option'
                    return 2
                }
                seen_composer=1
                composer_request="$2"
                shift 2
                ;;
            --linux-build)
                [[ "$seen_linux_build" -eq 0 && "$#" -ge 2 ]] || {
                    die 'invalid or duplicate --linux-build option'
                    return 2
                }
                seen_linux_build=1
                linux_build="$2"
                shift 2
                ;;
            *)
                die "unknown lock generator option: $1"
                return 2
                ;;
        esac
    done
    launcher="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/wari"
    generate_lock_file "$launcher" "$output" "$frankenphp_request" \
        "$composer_request" "$linux_build"
}

verify_checksum() {
    local algorithm="$1"
    local expected="$2"
    local file="$3"
    local actual

    actual="$(calculate_checksum "$algorithm" "$file")" || return 1
    if [[ "$actual" != "$expected" ]]; then
        printf 'Error: %s checksum mismatch.\nExpected: %s\nActual:   %s\n' \
            "$algorithm" "$expected" "$actual" >&2
        return 1
    fi
}

install_locked_frankenphp() {
    local staging="$1"
    local runtime_dir="$staging/runtime"
    local download="$runtime_dir/frankenphp.download"
    local url

    mkdir -p "$runtime_dir"
    select_locked_asset || return 1
    url="https://github.com/php/frankenphp/releases/download/v$LOCK_FRANKENPHP_VERSION/$ASSET_NAME"
    download_file "$url" "$download" "FrankenPHP $LOCK_FRANKENPHP_VERSION" || return 1
    verify_checksum sha256 "$ASSET_SHA256" "$download" || return 1
    mv -- "$download" "$runtime_dir/frankenphp"
    chmod 755 "$runtime_dir/frankenphp"
}

filter_composer_version_stderr() {
    sed \
        -e '/^PHP version [0-9][^ ]* (.*composer\.phar)$/d' \
        -e '/^Run the "diagnose" command to get more detailed diagnostics output\.$/d' \
        >&2
}

run_composer_version() {
    local status

    {
        "$@" 2>&1 1>&3 | filter_composer_version_stderr
        status="${PIPESTATUS[0]}"
    } 3>&1
    return "$status"
}

install_locked_composer() {
    local staging="$1"
    local runtime_dir="$staging/runtime"
    local setup="$staging/composer-setup.php"
    local output

    if [[ ! -x "$runtime_dir/frankenphp" ]]; then
        die 'FrankenPHP must be installed before Composer'
        return 1
    fi
    download_file 'https://getcomposer.org/installer' "$setup" 'Composer installer' || return 1
    verify_checksum sha384 "$LOCK_COMPOSER_INSTALLER_SHA384" "$setup" || return 1
    "$runtime_dir/frankenphp" php-cli "$setup" \
        --quiet \
        "--version=$LOCK_COMPOSER_VERSION" \
        "--install-dir=$runtime_dir" \
        --filename=composer.phar || return 1
    if [[ ! -f "$runtime_dir/composer.phar" || -L "$runtime_dir/composer.phar" ]]; then
        die 'Composer installer did not create a regular composer.phar'
        return 1
    fi
    verify_checksum sha256 "$LOCK_COMPOSER_SHA256" \
        "$runtime_dir/composer.phar" || return 1
    output="$(run_composer_version "$runtime_dir/frankenphp" php-cli \
        "$runtime_dir/composer.phar" --version)" || return 1
    if [[ "$output" != "Composer version $LOCK_COMPOSER_VERSION"* ]]; then
        die "installed Composer version does not match wari.lock: $output"
        return 1
    fi
    rm -f -- "$setup"
}

json_escape() {
    local value="$1"

    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\t'/\\t}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\n'/\\n}"
    printf '%s' "$value"
}

write_manifest() {
    local wari_dir="$1"
    local installed_at
    local linux_build_json='null'
    local asset_url

    installed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    if [[ "$PLATFORM_OS" == 'linux' ]]; then
        linux_build_json="\"$(json_escape "$LOCK_LINUX_BUILD")\""
    fi
    asset_url="https://github.com/php/frankenphp/releases/download/v$LOCK_FRANKENPHP_VERSION/$ASSET_NAME"

    printf '%s\n' "$WARI_RUNTIME_OWNER" >"$wari_dir/.wari-owned"
    {
        printf '{\n'
        printf '  "layout_version": 2,\n'
        printf '  "lock_sha256": "%s",\n' "$(json_escape "$LOCK_SHA256")"
        printf '  "wari_version": "%s",\n' "$(json_escape "$LOCK_WARI_VERSION")"
        printf '  "frankenphp_version": "%s",\n' "$(json_escape "$INSTALLED_FRANKENPHP_VERSION")"
        printf '  "php_version": "%s",\n' "$(json_escape "$INSTALLED_PHP_VERSION")"
        printf '  "composer_version": "%s",\n' "$(json_escape "$INSTALLED_COMPOSER_VERSION")"
        printf '  "os": "%s",\n' "$(json_escape "$PLATFORM_OS")"
        printf '  "architecture": "%s",\n' "$(json_escape "$PLATFORM_ARCH")"
        printf '  "linux_build": %s,\n' "$linux_build_json"
        printf '  "asset": "%s",\n' "$(json_escape "$ASSET_NAME")"
        printf '  "asset_url": "%s",\n' "$(json_escape "$asset_url")"
        printf '  "asset_sha256": "%s",\n' "$(json_escape "$ASSET_SHA256")"
        printf '  "composer_sha256": "%s",\n' "$(json_escape "$LOCK_COMPOSER_SHA256")"
        printf '  "checksum_verified": true,\n'
        printf '  "slsa_verified": false,\n'
        printf '  "installed_at": "%s"\n' "$(json_escape "$installed_at")"
        printf '}\n'
    } >"$wari_dir/manifest.json"
}

run_staged_smoke_checks() {
    local wari_dir="$1"

    "$wari_dir/php" --version >/dev/null
    "$wari_dir/composer" --version >/dev/null
    "$wari_dir/create-project" --help >/dev/null
    "$wari_dir/frankenphp" version >/dev/null
    "$wari_dir/php" -r \
        '$data = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR); exit(is_array($data) ? 0 : 1);' \
        "$wari_dir/manifest.json" >/dev/null
}

detect_installed_versions() {
    local wari_dir="$1"
    local output

    output="$("$wari_dir/php" --version)" || return 1
    INSTALLED_PHP_VERSION="$(printf '%s\n' "$output" | sed -n \
        's/^PHP \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | sed -n '1p')"
    output="$("$wari_dir/frankenphp" version)" || return 1
    INSTALLED_FRANKENPHP_VERSION="$(printf '%s\n' "$output" | sed -n \
        's/.*FrankenPHP v\{0,1\}\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | sed -n '1p')"
    output="$("$wari_dir/composer" --version)" || return 1
    INSTALLED_COMPOSER_VERSION="$(printf '%s\n' "$output" | sed -n \
        's/^Composer version \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | sed -n '1p')"
    [[ -n "$INSTALLED_PHP_VERSION" &&
        "$INSTALLED_FRANKENPHP_VERSION" == "$LOCK_FRANKENPHP_VERSION" &&
        "$INSTALLED_COMPOSER_VERSION" == "$LOCK_COMPOSER_VERSION" ]] || {
        die 'installed runtime versions do not match wari.lock'
        return 1
    }
}

is_safe_setup_path() {
    local project_root="$1"
    local path="$2"
    local prefix="$3"
    local parent
    local base

    [[ -n "$project_root" && -n "$path" ]] || return 1
    parent="$(dirname -- "$path")"
    base="$(basename -- "$path")"
    [[ "$parent" == "$project_root" && "$base" == "$prefix".?* ]]
}

is_recognized_runtime() {
    local runtime_dir="$1"

    [[ -d "$runtime_dir" && ! -L "$runtime_dir" &&
        -f "$runtime_dir/.wari-owned" && ! -L "$runtime_dir/.wari-owned" &&
        -f "$runtime_dir/manifest.json" && ! -L "$runtime_dir/manifest.json" ]] || return 1
    [[ "$(<"$runtime_dir/.wari-owned")" == "$WARI_RUNTIME_OWNER" &&
        "$(manifest_integer "$runtime_dir/manifest.json" layout_version)" == '2' ]]
}

cleanup_setup() {
    local status=$?

    if [[ "${NEW_RUNTIME_PUBLISHED:-0}" -eq 1 &&
        "${OLD_RUNTIME_BACKED_UP:-0}" -eq 1 ]]; then
        if is_recognized_runtime "$WARI_PROJECT_ROOT/.wari" &&
            is_safe_setup_path "$WARI_PROJECT_ROOT" "$RUNTIME_BACKUP" '.wari-backup'; then
            rm -rf -- "$WARI_PROJECT_ROOT/.wari"
            mv -- "$RUNTIME_BACKUP" "$WARI_PROJECT_ROOT/.wari"
            OLD_RUNTIME_BACKED_UP=0
        fi
    elif [[ "${NEW_RUNTIME_PUBLISHED:-0}" -eq 1 &&
        "${OLD_RUNTIME_BACKED_UP:-0}" -eq 0 ]]; then
        if is_recognized_runtime "$WARI_PROJECT_ROOT/.wari"; then
            rm -rf -- "$WARI_PROJECT_ROOT/.wari"
        fi
    fi
    if [[ -n "${SETUP_STAGING:-}" && -d "$SETUP_STAGING" ]] &&
        is_safe_setup_path "$WARI_PROJECT_ROOT" "$SETUP_STAGING" '.wari-install'; then
        rm -rf -- "$SETUP_STAGING"
    fi
    if [[ "${OLD_RUNTIME_BACKED_UP:-0}" -eq 1 ]] &&
        is_safe_setup_path "$WARI_PROJECT_ROOT" "$RUNTIME_BACKUP" '.wari-backup'; then
        mv -- "$RUNTIME_BACKUP" "$WARI_PROJECT_ROOT/.wari" 2>/dev/null || true
    fi
    if [[ "${SETUP_LOCK_OWNED:-0}" -eq 1 &&
        "$SETUP_LOCK" == "$WARI_PROJECT_ROOT/.wari-setup.lock" ]]; then
        rm -rf -- "$SETUP_LOCK"
    fi
    exit "$status"
}

confirm_setup() {
    local answer

    if ! { exec 3</dev/tty 4>/dev/tty; } 2>/dev/null; then
        die 'setup requires confirmation; pass --yes for automation'
        return 2
    fi
    printf 'Install or replace this project local Wari runtime? [y/N]: ' >&4
    IFS= read -r answer <&3 || return 2
    case "$answer" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

confirm_tracked_change() {
    local prompt="$1"
    local answer

    if ! { exec 3</dev/tty 4>/dev/tty; } 2>/dev/null; then
        die 'tracked-file update requires confirmation; pass --yes for automation'
        return 2
    fi
    printf '%s [y/N]: ' "$prompt" >&4
    IFS= read -r answer <&3 || return 2
    case "$answer" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

setup_main() (
    local assume_yes=0
    local argument

    for argument in "$@"; do
        case "$argument" in
            --yes) assume_yes=1 ;;
            --help|-h)
                printf '%s\n' 'Usage: ./wari setup [--yes]'
                return 0
                ;;
            *) die "unknown setup option: $argument"; return 2 ;;
        esac
    done

    WARI_PROJECT_ROOT="${WARI_PROJECT_ROOT:-$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
    WARI_RUNTIME_DIR="$WARI_PROJECT_ROOT/.wari"
    parse_lock "$WARI_PROJECT_ROOT/wari.lock" || return 1
    detect_current_platform || return 1
    if [[ "$PLATFORM_OS" == 'linux' && "$LOCK_LINUX_BUILD" == 'gnu' ]] &&
        ! has_glibc; then
        die 'GNU Wari runtime requires glibc; use a lock generated for the static build'
        return 1
    fi
    LOCK_SHA256="$(lock_digest "$WARI_PROJECT_ROOT/wari.lock")" || return 1

    if [[ -e "$WARI_RUNTIME_DIR" || -L "$WARI_RUNTIME_DIR" ]]; then
        if validate_runtime "$WARI_PROJECT_ROOT" >/dev/null 2>&1; then
            printf 'Wari runtime is already ready.\n'
            return 0
        fi
        if ! is_recognized_runtime "$WARI_RUNTIME_DIR"; then
            die '.wari/ exists but is not recognized as a Wari runtime'
            return 1
        fi
    fi

    if [[ "$assume_yes" -ne 1 ]]; then
        if confirm_setup; then
            :
        else
            confirm_status=$?
            if [[ "$confirm_status" -eq 1 ]]; then
                printf 'Wari setup cancelled.\n'
                return 0
            fi
            return 1
        fi
    fi

    SETUP_LOCK="$WARI_PROJECT_ROOT/.wari-setup.lock"
    SETUP_LOCK_OWNED=0
    SETUP_STAGING=''
    RUNTIME_BACKUP=''
    OLD_RUNTIME_BACKED_UP=0
    NEW_RUNTIME_PUBLISHED=0
    trap cleanup_setup EXIT
    trap '' INT TERM HUP
    if ! mkdir -- "$SETUP_LOCK" 2>/dev/null; then
        die 'another Wari setup is already running'
        return 1
    fi
    SETUP_LOCK_OWNED=1
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    printf '%s\n' "$$" >"$SETUP_LOCK/pid" || return 1
    SETUP_STAGING="$(mktemp -d "$WARI_PROJECT_ROOT/.wari-install.XXXXXX")" || return $?

    install_locked_frankenphp "$SETUP_STAGING" || return 1
    install_locked_composer "$SETUP_STAGING" || return 1
    generate_wrappers "$SETUP_STAGING" || return 1
    detect_installed_versions "$SETUP_STAGING" || return 1
    write_manifest "$SETUP_STAGING" || return 1
    run_staged_smoke_checks "$SETUP_STAGING" || return 1

    if [[ -d "$WARI_RUNTIME_DIR" ]]; then
        RUNTIME_BACKUP="$(mktemp -d "$WARI_PROJECT_ROOT/.wari-backup.XXXXXX")"
        rmdir -- "$RUNTIME_BACKUP"
        mv -- "$WARI_RUNTIME_DIR" "$RUNTIME_BACKUP" || return 1
        OLD_RUNTIME_BACKED_UP=1
    fi
    mv -- "$SETUP_STAGING" "$WARI_RUNTIME_DIR" || return 1
    SETUP_STAGING=''
    NEW_RUNTIME_PUBLISHED=1
    validate_runtime "$WARI_PROJECT_ROOT" || return 1

    if [[ "$OLD_RUNTIME_BACKED_UP" -eq 1 ]]; then
        rm -rf -- "$RUNTIME_BACKUP"
        OLD_RUNTIME_BACKED_UP=0
    fi
    rm -rf -- "$SETUP_LOCK"
    SETUP_LOCK_OWNED=0
    NEW_RUNTIME_PUBLISHED=0
    trap - EXIT INT TERM HUP
    printf 'Wari runtime is ready.\n'
)

validate_launcher_pair() {
    local launcher="$1"
    local lock="$2"
    local actual_sha
    local reported_version

    parse_lock "$lock" || return 1
    actual_sha="$(calculate_checksum sha256 "$launcher")" || return 1
    [[ "$actual_sha" == "$LOCK_WARI_SHA256" ]] || {
        die 'tracked Wari launcher has local modifications or does not match wari.lock'
        return 1
    }
    reported_version="$(bash "$launcher" --version-value)" || return 1
    [[ "$reported_version" == "$LOCK_WARI_VERSION" ]] || {
        die 'Wari launcher version does not match wari.lock'
        return 1
    }
}

generate_update_lock() {
    local launcher="$1"
    local output="$2"
    local frankenphp_request="$3"
    local composer_request="$4"
    local linux_build="$5"
    local -a arguments

    arguments=(--generate-lock "$output" --linux-build "$linux_build")
    [[ -z "$frankenphp_request" ]] || arguments+=(--frankenphp "$frankenphp_request")
    [[ -z "$composer_request" ]] || arguments+=(--composer "$composer_request")
    bash "$launcher" "${arguments[@]}"
}

update_main() (
    local assume_yes=0
    local frankenphp_request=''
    local composer_request=''
    local linux_build_request=''
    local seen_frankenphp=0 seen_composer=0 seen_linux_build=0
    local current_wari_version current_wari_sha current_frankenphp current_composer
    local current_linux_build candidate_wari_version candidate_wari_sha
    local candidate_frankenphp candidate_composer candidate_linux_build
    local staging confirm_status
    local lock_published=0 restore_failed=0

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --yes) assume_yes=1; shift ;;
            --frankenphp)
                [[ "$seen_frankenphp" -eq 0 && "$#" -ge 2 ]] || {
                    die 'invalid or duplicate --frankenphp option'; return 2;
                }
                seen_frankenphp=1; frankenphp_request="$2"; shift 2
                ;;
            --composer)
                [[ "$seen_composer" -eq 0 && "$#" -ge 2 ]] || {
                    die 'invalid or duplicate --composer option'; return 2;
                }
                seen_composer=1; composer_request="$2"; shift 2
                ;;
            --linux-build)
                [[ "$seen_linux_build" -eq 0 && "$#" -ge 2 ]] || {
                    die 'invalid or duplicate --linux-build option'; return 2;
                }
                seen_linux_build=1; linux_build_request="$2"; shift 2
                ;;
            --help|-h)
                printf '%s\n' \
                    'Usage: ./wari update [--yes] [--frankenphp VERSION]' \
                    '       [--composer VERSION] [--linux-build static|gnu]'
                return 0
                ;;
            *) die "unknown update option: $1"; return 2 ;;
        esac
    done
    [[ -z "$frankenphp_request" ]] || validate_semver "$frankenphp_request" || return 2
    [[ -z "$composer_request" ]] || validate_semver "$composer_request" || return 2
    [[ -z "$linux_build_request" || "$linux_build_request" == static ||
        "$linux_build_request" == gnu ]] || {
        die "invalid Linux build: $linux_build_request"; return 2;
    }

    WARI_PROJECT_ROOT="${WARI_PROJECT_ROOT:-$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
    WARI_LAUNCHER="${WARI_LAUNCHER:-$WARI_PROJECT_ROOT/wari}"
    validate_launcher_pair "$WARI_LAUNCHER" "$WARI_PROJECT_ROOT/wari.lock" || return 1
    current_wari_version="$LOCK_WARI_VERSION"
    current_wari_sha="$LOCK_WARI_SHA256"
    current_frankenphp="$LOCK_FRANKENPHP_VERSION"
    current_composer="$LOCK_COMPOSER_VERSION"
    current_linux_build="$LOCK_LINUX_BUILD"
    [[ -n "$linux_build_request" ]] || linux_build_request="$current_linux_build"

    staging="$(mktemp -d "$WARI_PROJECT_ROOT/.wari-update.XXXXXX")" || return $?
    cleanup_dependency_update() {
        local status=$?
        if [[ "$lock_published" -eq 1 && -f "$staging/wari.lock.old" ]]; then
            cp "$staging/wari.lock.old" "$WARI_PROJECT_ROOT/wari.lock" || \
                restore_failed=1
        fi
        if [[ "$restore_failed" -eq 0 ]]; then
            case "$staging" in
                "$WARI_PROJECT_ROOT"/.wari-update.?*) rm -rf -- "$staging" ;;
            esac
        else
            printf 'Error: dependency update rollback failed; recovery files remain in %s\n' \
                "$staging" >&2
        fi
        exit "$status"
    }
    trap cleanup_dependency_update EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP

    cp "$WARI_LAUNCHER" "$staging/wari" || return 1
    chmod 755 "$staging/wari"
    generate_update_lock "$staging/wari" "$staging/wari.lock" \
        "$frankenphp_request" "$composer_request" "$linux_build_request" || return 1
    validate_launcher_pair "$staging/wari" "$staging/wari.lock" || return 1
    candidate_wari_version="$LOCK_WARI_VERSION"
    candidate_wari_sha="$LOCK_WARI_SHA256"
    candidate_frankenphp="$LOCK_FRANKENPHP_VERSION"
    candidate_composer="$LOCK_COMPOSER_VERSION"
    candidate_linux_build="$LOCK_LINUX_BUILD"
    [[ "$candidate_wari_version" == "$current_wari_version" &&
        "$candidate_wari_sha" == "$current_wari_sha" ]] || {
        die 'dependency update attempted to change the Wari launcher identity'
        return 1
    }
    printf '%s\n' \
        "FrankenPHP: $current_frankenphp -> $candidate_frankenphp" \
        "Composer:   $current_composer -> $candidate_composer" \
        "Linux build: $current_linux_build -> $candidate_linux_build"

    if cmp -s "$WARI_PROJECT_ROOT/wari.lock" "$staging/wari.lock"; then
        rm -rf -- "$staging"
        trap - EXIT INT TERM HUP
        printf 'Wari dependency lock is already current.\n'
        return 0
    fi
    if [[ "$assume_yes" -ne 1 ]]; then
        if confirm_tracked_change 'Update this project wari.lock?'; then :; else
            confirm_status=$?
            if [[ "$confirm_status" -eq 1 ]]; then
                printf 'Wari update cancelled.\n'
                return 0
            fi
            return 1
        fi
    fi

    cp "$WARI_PROJECT_ROOT/wari.lock" "$staging/wari.lock.old" || return 1
    trap '' INT TERM HUP
    if ! mv -- "$staging/wari.lock" "$WARI_PROJECT_ROOT/wari.lock"; then
        trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
        return 1
    fi
    lock_published=1
    trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
    validate_launcher_pair "$WARI_LAUNCHER" "$WARI_PROJECT_ROOT/wari.lock" || return 1
    rm -rf -- "$staging"
    lock_published=0
    trap - EXIT INT TERM HUP
    printf '%s\n' '' 'Review wari.lock, then run:' '  ./wari setup'
)

fetch_tagged_wari_launcher() {
    local staging="$1"
    local version="$2"
    local url

    validate_semver "$version" || return 1
    url="https://raw.githubusercontent.com/wednesdaymoonlab/wari/v$version/wari"
    download_file "$url" "$staging/wari" "Wari $version launcher" || return 1
    chmod 755 "$staging/wari"
}

generate_self_update_lock() {
    local launcher="$1"
    local output="$2"
    local frankenphp_version="$3"
    local composer_version="$4"
    local linux_build="$5"

    bash "$launcher" --generate-lock "$output" \
        --frankenphp "$frankenphp_version" \
        --composer "$composer_version" \
        --linux-build "$linux_build"
}

self_update_main() (
    local target_version="${1-}"
    local assume_yes=0
    local current_version current_frankenphp current_composer current_linux_build
    local candidate_version staging confirm_status
    local launcher_published=0 lock_published=0 restore_failed=0

    if [[ "$target_version" == --help || "$target_version" == -h ]]; then
        printf '%s\n' 'Usage: ./wari self-update VERSION [--yes]'
        return 0
    fi
    [[ -n "$target_version" ]] || {
        die 'Usage: ./wari self-update VERSION [--yes]'
        return 2
    }
    shift
    validate_semver "$target_version" || return 2
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --yes) assume_yes=1; shift ;;
            *) die "unknown self-update option: $1"; return 2 ;;
        esac
    done

    WARI_PROJECT_ROOT="${WARI_PROJECT_ROOT:-$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
    WARI_LAUNCHER="${WARI_LAUNCHER:-$WARI_PROJECT_ROOT/wari}"
    validate_launcher_pair "$WARI_LAUNCHER" "$WARI_PROJECT_ROOT/wari.lock" || return 1
    current_version="$LOCK_WARI_VERSION"
    current_frankenphp="$LOCK_FRANKENPHP_VERSION"
    current_composer="$LOCK_COMPOSER_VERSION"
    current_linux_build="$LOCK_LINUX_BUILD"

    staging="$(mktemp -d "$WARI_PROJECT_ROOT/.wari-update.XXXXXX")" || return $?
    cleanup_self_update() {
        local status=$?
        if [[ "$lock_published" -eq 1 && -f "$staging/wari.lock.old" ]]; then
            cp "$staging/wari.lock.old" "$WARI_PROJECT_ROOT/wari.lock" || restore_failed=1
        fi
        if [[ "$launcher_published" -eq 1 && -f "$staging/wari.old" ]]; then
