validate_project_root() {
    local candidate name count=0

    if [[ ! -d "$WARI_DIR" || -L "$WARI_DIR" ]]; then
        create_project_error "Wari runtime directory is invalid: $WARI_DIR"
        return 1
    fi
    if [[ ! -f "$PROJECT_ROOT/wari" || ! -x "$PROJECT_ROOT/wari" ||
        -L "$PROJECT_ROOT/wari" ]]; then
        create_project_error "Wari dispatcher is invalid: $PROJECT_ROOT/wari"
        return 1
    fi
    if [[ ! -f "$PROJECT_ROOT/wari.lock" || -L "$PROJECT_ROOT/wari.lock" ]]; then
        create_project_error "Wari lock is invalid: $PROJECT_ROOT/wari.lock"
        return 1
    fi
    if [[ ! -f "$PROJECT_ROOT/.gitignore" || -L "$PROJECT_ROOT/.gitignore" ]] ||
        ! has_wari_ignore_block "$PROJECT_ROOT/.gitignore"; then
        create_project_error 'Wari bootstrap .gitignore is invalid'
        return 1
    fi
    if [[ ! -x "$WARI_DIR/php" || ! -x "$WARI_DIR/composer" ||
        ! -x "$WARI_DIR/create-project" ||
        ! -f "$WARI_DIR/runtime/composer.phar" ]]; then
        create_project_error 'Wari runtime is incomplete'
        return 1
    fi

    while IFS= read -r -d '' candidate; do
        name="${candidate##*/}"
        case "$name" in
            wari|wari.lock|.wari|.gitignore) ;;
            *)
                create_project_error \
                    "project directory contains an unsupported entry: $name"
                return 1
                ;;
        esac
        count=$((count + 1))
    done < <(find "$PROJECT_ROOT" -mindepth 1 -maxdepth 1 -print0)

    if [[ "$count" -ne 4 ]]; then
        create_project_error \
            'project directory must contain only wari, wari.lock, .wari/, and .gitignore'
        return 1
    fi
}

